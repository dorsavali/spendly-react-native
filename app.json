{
  "expo": {
    "name": "spendly",
    "slug": "spendly",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "spendly",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.spendly",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.spendly"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "77aed3e6-3fa4-4451-bd56-fcbc95cf42b7"
      }
    }
  }
}
