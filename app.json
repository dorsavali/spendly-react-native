{
  "expo": {
    "name": "spendly",
    "slug": "spendly",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "spendly",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    }
  }
}
